// This Pine Script™ source code is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/

//@version=6
strategy("NASDAQ Intraday Strategy", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=10, initial_capital=100000, commission_type=strategy.commission.percent, commission_value=0.02, slippage=1, calc_on_every_tick=false)

// ══════════════════════════════════════════════════════════════════════════════
// НАСТРОЙКИ СТРАТЕГИИ
// ══════════════════════════════════════════════════════════════════════════════

// --- Параметры EMA ---
emaFastLen   = input.int(9,   "EMA Быстрая",       minval=2,  group="Скользящие средние")
emaSlowLen   = input.int(21,  "EMA Медленная",      minval=5,  group="Скользящие средние")
emaTrendLen  = input.int(50,  "EMA Тренд (фильтр)", minval=10, group="Скользящие средние")

// --- RSI ---
rsiLen       = input.int(14,  "RSI Период",         minval=2,  group="RSI")
rsiOB        = input.int(70,  "RSI Перекупленность", minval=50, group="RSI")
rsiOS        = input.int(30,  "RSI Перепроданность", minval=10, group="RSI")

// --- ATR для стопов ---
atrLen       = input.int(14,  "ATR Период",          minval=1,  group="Управление риском")
atrSlMult    = input.float(1.5, "ATR множитель стоп-лосс", minval=0.5, step=0.1, group="Управление риском")
atrTpMult    = input.float(2.5, "ATR множитель тейк-профит", minval=0.5, step=0.1, group="Управление риском")

// --- VWAP ---
useVwap      = input.bool(true, "Использовать VWAP фильтр", group="VWAP")

// --- Сессия ---
sessStart    = input.session("0930-1530", "Торговая сессия (NYSE)", group="Время")
closeEOD     = input.bool(true, "Закрывать позиции в конце дня", group="Время")
closeTime    = input.int(1545,  "Время закрытия позиций (HHMM)", group="Время")

// --- Объём ---
useVolFilter = input.bool(true, "Фильтр по объёму", group="Объём")
volMaLen     = input.int(20,    "Период MA объёма",  minval=5, group="Объём")
volMult      = input.float(1.2, "Множитель объёма",  minval=0.5, step=0.1, group="Объём")

// ══════════════════════════════════════════════════════════════════════════════
// РАСЧЁТ ИНДИКАТОРОВ
// ══════════════════════════════════════════════════════════════════════════════

// Скользящие средние
emaFast  = ta.ema(close, emaFastLen)
emaSlow  = ta.ema(close, emaSlowLen)
emaTrend = ta.ema(close, emaTrendLen)

// RSI
rsiVal = ta.rsi(close, rsiLen)

// ATR
atrVal = ta.atr(atrLen)

// VWAP (доступен только на интрадей таймфреймах)
vwapVal = ta.vwap(hlc3)

// Объём
volMa       = ta.sma(volume, volMaLen)
volConfirm  = not useVolFilter or (volume > volMa * volMult)

// ══════════════════════════════════════════════════════════════════════════════
// УСЛОВИЯ СЕССИИ
// ══════════════════════════════════════════════════════════════════════════════

inSession = not na(time(timeframe.period, sessStart))
currTime  = hour * 100 + minute
shouldClose = closeEOD and currTime >= closeTime

// ══════════════════════════════════════════════════════════════════════════════
// ТОРГОВЫЕ СИГНАЛЫ
// ══════════════════════════════════════════════════════════════════════════════

// --- Тренд ---
bullTrend = close > emaTrend
bearTrend = close < emaTrend

// --- Пересечение EMA ---
emaCrossUp   = ta.crossover(emaFast, emaSlow)
emaCrossDown = ta.crossunder(emaFast, emaSlow)

// --- RSI фильтр ---
rsiBullOk = rsiVal > rsiOS and rsiVal < rsiOB
rsiBearOk = rsiVal > rsiOS and rsiVal < rsiOB

// --- VWAP фильтр ---
vwapBullOk = not useVwap or (close > vwapVal)
vwapBearOk = not useVwap or (close < vwapVal)

// --- Комбинированные сигналы ---
longSignal  = emaCrossUp   and bullTrend and rsiBullOk and vwapBullOk and volConfirm and inSession and not shouldClose
shortSignal = emaCrossDown and bearTrend and rsiBearOk and vwapBearOk and volConfirm and inSession and not shouldClose

// ══════════════════════════════════════════════════════════════════════════════
// ИСПОЛНЕНИЕ ОРДЕРОВ
// ══════════════════════════════════════════════════════════════════════════════

if longSignal and strategy.position_size <= 0
    slPrice = close - atrVal * atrSlMult
    tpPrice = close + atrVal * atrTpMult
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", stop=slPrice, limit=tpPrice)

if shortSignal and strategy.position_size >= 0
    slPrice = close + atrVal * atrSlMult
    tpPrice = close - atrVal * atrTpMult
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", "Short", stop=slPrice, limit=tpPrice)

// Закрытие в конце дня
if shouldClose and strategy.position_size != 0
    strategy.close_all(comment="EOD Close")

// ══════════════════════════════════════════════════════════════════════════════
// ВИЗУАЛИЗАЦИЯ
// ══════════════════════════════════════════════════════════════════════════════

// EMA линии
plot(emaFast,  "EMA Быстрая",  color=color.new(color.blue, 0),   linewidth=1)
plot(emaSlow,  "EMA Медленная", color=color.new(color.orange, 0), linewidth=1)
plot(emaTrend, "EMA Тренд",    color=color.new(color.gray, 30),  linewidth=2)

// VWAP
plot(useVwap ? vwapVal : na, "VWAP", color=color.new(color.purple, 0), linewidth=2, style=plot.style_circles)

// Сигналы на графике
plotshape(longSignal,  title="Long",  location=location.belowbar, style=shape.triangleup,   color=color.new(color.green, 0), size=size.small)
plotshape(shortSignal, title="Short", location=location.abovebar, style=shape.triangledown, color=color.new(color.red, 0),   size=size.small)

// Фон сессии
bgcolor(inSession ? color.new(color.blue, 95) : na, title="Торговая сессия")
bgcolor(shouldClose ? color.new(color.red, 90) : na, title="Зона закрытия")

// ══════════════════════════════════════════════════════════════════════════════
// ИНФОРМАЦИОННАЯ ПАНЕЛЬ
// ══════════════════════════════════════════════════════════════════════════════

var table infoPanel = table.new(position.top_right, 2, 7, bgcolor=color.new(color.black, 80), border_width=1)

if barstate.islast
    table.cell(infoPanel, 0, 0, "Параметр",       text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 1, 0, "Значение",        text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 0, 1, "RSI",             text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 1, 1, str.tostring(rsiVal, "#.0"), text_color=rsiVal > rsiOB ? color.red : rsiVal < rsiOS ? color.green : color.white, text_size=size.small)
    table.cell(infoPanel, 0, 2, "ATR",             text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 1, 2, str.tostring(atrVal, "#.00"), text_color=color.yellow, text_size=size.small)
    table.cell(infoPanel, 0, 3, "Тренд",           text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 1, 3, bullTrend ? "БЫЧИЙ" : "МЕДВЕЖИЙ", text_color=bullTrend ? color.green : color.red, text_size=size.small)
    table.cell(infoPanel, 0, 4, "VWAP",            text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 1, 4, close > vwapVal ? "Выше" : "Ниже", text_color=close > vwapVal ? color.green : color.red, text_size=size.small)
    table.cell(infoPanel, 0, 5, "Объём/MA",        text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 1, 5, str.tostring(volume / volMa, "#.00") + "x", text_color=volConfirm ? color.green : color.gray, text_size=size.small)
    table.cell(infoPanel, 0, 6, "Позиция",         text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 1, 6, strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "НЕТ", text_color=strategy.position_size > 0 ? color.green : strategy.position_size < 0 ? color.red : color.gray, text_size=size.small)
